  SET {c98a2c5b-406b-476a-94fe-c12e683ca90f} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {6f38eac7-c605-4ce8-bfda-9f6b8a60a44a}<23.9 && {6f38eac7-c605-4ce8-bfda-9f6b8a60a44a}>1.7, !- Program Line 4
  SET {1a5084c2-cbfb-4a80-ad18-ec4c3e284cb4} = 29.4, !- Program Line 5
  SET {c98a2c5b-406b-476a-94fe-c12e683ca90f} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {6f38eac7-c605-4ce8-bfda-9f6b8a60a44a}<23.9 && {6f38eac7-c605-4ce8-bfda-9f6b8a60a44a}>1.7, !- Program Line 7
  SET {1a5084c2-cbfb-4a80-ad18-ec4c3e284cb4} = 29.4, !- Program Line 8
  SET {c98a2c5b-406b-476a-94fe-c12e683ca90f} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {6f38eac7-c605-4ce8-bfda-9f6b8a60a44a}<23.9 && {6f38eac7-c605-4ce8-bfda-9f6b8a60a44a}>1.7, !- Program Line 10
  SET {1a5084c2-cbfb-4a80-ad18-ec4c3e284cb4} = 29.4, !- Program Line 11
  SET {c98a2c5b-406b-476a-94fe-c12e683ca90f} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {1a5084c2-cbfb-4a80-ad18-ec4c3e284cb4} = NULL, !- Program Line 14
  SET {c98a2c5b-406b-476a-94fe-c12e683ca90f} = NULL, !- Program Line 15
