  ems_sys_1_mixed_shr_none_sc_ccashp_sh_ccashp_ssf_vv_zh_b_e_zc_none_srf_vv__OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {6f38eac7-c605-4ce8-bfda-9f6b8a60a44a}<23.9 && {6f38eac7-c605-4ce8-bfda-9f6b8a60a44a}>1.7, !- Program Line 1
