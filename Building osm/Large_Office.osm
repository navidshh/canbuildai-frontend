  SET {52ebd9b0-12ed-4027-a79a-601a83682cee} = 29.4, !- Program Line 8
  SET {035ed000-d5bd-4df8-b316-be3a023a7291} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {ac8fa7e6-2c7c-41d7-9322-d7e1cbaba4de}<23.9 && {ac8fa7e6-2c7c-41d7-9322-d7e1cbaba4de}>1.7, !- Program Line 10
  SET {52ebd9b0-12ed-4027-a79a-601a83682cee} = 29.4, !- Program Line 11
  SET {035ed000-d5bd-4df8-b316-be3a023a7291} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {52ebd9b0-12ed-4027-a79a-601a83682cee} = NULL, !- Program Line 14
