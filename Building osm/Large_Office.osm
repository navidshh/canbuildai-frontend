  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {b0ce40f5-b341-4d12-a8db-a57f0508b45d}<23.9 && {b0ce40f5-b341-4d12-a8db-a57f0508b45d}>1.7, !- Program Line 10
