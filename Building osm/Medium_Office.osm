  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {a9208476-5b39-49eb-b0a8-9b3255910328}<23.9 && {a9208476-5b39-49eb-b0a8-9b3255910328}>1.7, !- Program Line 4
  SET {a7932a6e-c8be-49d9-8bfe-d669d42ed95d} = 29.4, !- Program Line 5
  SET {fc4daf40-cef2-4151-8c3a-0711ef94a37e} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {a9208476-5b39-49eb-b0a8-9b3255910328}<23.9 && {a9208476-5b39-49eb-b0a8-9b3255910328}>1.7, !- Program Line 7
  SET {a7932a6e-c8be-49d9-8bfe-d669d42ed95d} = 29.4, !- Program Line 8
  SET {fc4daf40-cef2-4151-8c3a-0711ef94a37e} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {a9208476-5b39-49eb-b0a8-9b3255910328}<23.9 && {a9208476-5b39-49eb-b0a8-9b3255910328}>1.7, !- Program Line 10
  SET {a7932a6e-c8be-49d9-8bfe-d669d42ed95d} = 29.4, !- Program Line 11
